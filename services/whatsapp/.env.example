# Store actual values in the hosting service's secret manager, never in Git or BUS.
META_APP_SECRET=
META_VERIFY_TOKEN=
META_ACCESS_TOKEN=
META_PHONE_NUMBER_ID=
# Use a supported Graph version shown in your Meta app; do not silently default it.
META_GRAPH_VERSION=
OPENAI_API_KEY=
# Choose a Responses-compatible model available to your OpenAI project.
OPENAI_MODEL=
# Your personal WhatsApp number, international digits with no leading +.
WHATSAPP_ALLOWED_SENDERS=
# Absolute file path on a persistent private volume, outside the static web root.
BRIDGE_DB=
BRIDGE_HOST=127.0.0.1
PORT=8080
